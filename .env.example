# ---- Banco ----
DATABASE_URL="postgresql://user:password@localhost:5432/leonidaplay?schema=public"

# ---- Site ----
# URL pública (HTTPS) — usada no webhook do Mercado Pago e nos metadados
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Login (código por e-mail) ----
# Obrigatório em produção, mín. 32 caracteres: openssl rand -base64 32
AUTH_SECRET=""
# Resend (resend.com). Vazio fora de produção = código aparece na tela (modo de teste)
RESEND_API_KEY=""
EMAIL_FROM="LeonidaPlay <nao-responda@seudominio.com.br>"

# Cifra CPF e chave Pix dos anfitriões (AES-256-GCM). 32 bytes: openssl rand -base64 32
# NUNCA troque depois de ter anfitriões cadastrados — os dados antigos ficariam ilegíveis. Guarde uma cópia segura.
PII_ENCRYPTION_KEY=""
# Teste de envio real de e-mail rodando local (padrão: código aparece na tela)
EMAIL_SEND_IN_DEV=""

# ---- Painel /admin (usuário: admin) ----
ADMIN_PASSWORD=""
# Conta técnica que assina o log de auditoria das ações do painel
ADMIN_EMAIL=""

# ---- Mercado Pago (Pix) ----
# Vazio = Pix simulado | TEST-... = sandbox | APP_USR-... = produção (dinheiro real)
MP_ACCESS_TOKEN=""
# "Chave secreta" das notificações (Webhooks) no painel do MP — obrigatória em produção
MP_WEBHOOK_SECRET=""
# Site publicado em modo de teste (Pix simulado/sandbox + botão "Simular pago"): só com 1
PAYMENTS_TEST_MODE=""

# ---- Criptografia de credenciais PSN (envelope encryption) ----
# Em produção: KMS. Em dev: chave local de 32 bytes em base64.
CREDENTIALS_MASTER_KEY=""

# ---- Grants de sessão (Ed25519) — o relay só aceita grants assinados com esta chave ----
SESSION_GRANT_PRIVATE_KEY=""
SESSION_GRANT_PUBLIC_KEY=""

# ---- Relay ----
RELAY_SHARED_SECRET=""
TURN_SECRET=""
